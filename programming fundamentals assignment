#include <stdio.h>
#include <string.h>

struct cliente {
    char nombre[50];
    int unidad;
    double precio;
    char estado[20];
};

int main(void) {
    int num;
    printf("INGRESE LA CANTIDAD DE FACTURAS:");
    scanf("%d", &num);
    struct cliente c[10];
    getchar(); 

    for (int i = 0; i < num; i++) {
        printf("\nIngrese nombre:");
        fgets(c[i].nombre, 50, stdin);
        printf("\nIngrese el numero de unidades compradas: ");
        scanf("%d", &c[i].unidad);
        printf("\nIngrese el precio de la unidad:");
        scanf("%lf", &c[i].precio);
        printf("\nIngrese el estado de la persona (atrasado, pagado, demoroso): ");
        scanf("%s", c[i].estado);
        getchar(); 
    }

    printf("\nClientes en estado demoroso:\n");
    for (int i = 0; i < num; i++) {
        if (strcmp(c[i].estado, "demoroso") == 0) {
            printf("Nombre: %s\n", c[i].nombre);
            printf("Cantidad: %d\n", c[i].unidad);
            printf("PrecioUnidad: %.2lf\n", c[i].precio);
            printf("Totalfactura: %.2lf\n", c[i].unidad * c[i].precio);
            printf("Estado: %s\n\n", c[i].estado);
        }
    }

    printf("Clientes en estado atrasado:\n");
    for (int i = 0; i < num; i++) {
        if (strcmp(c[i].estado, "atrasado") == 0) {
            printf("Nombre: %s\n", c[i].nombre);
            printf("Cantidad: %d\n", c[i].unidad);
            printf("PrecioUnidad: %.2lf\n", c[i].precio);
            printf("Totalfactura: %.2lf\n", c[i].unidad * c[i].precio);
            printf("Estado: %s\n\n", c[i].estado);
        }
    }

    double valordereferencia = 10.0;
    printf("Clientes con facturas pagadas mayor al monto de %.2lf:\n", valordereferencia);
    for (int i = 0; i < num; i++) {
        if (strcmp(c[i].estado, "pagado") == 0 && (c[i].unidad * c[i].precio) > valordereferencia) {
            printf("Nombre: %s\n", c[i].nombre);
            printf("Cantidad: %d\n", c[i].unidad);
            printf("PrecioUnidad: %.2lf\n", c[i].precio);
            printf("Totalfactura: %.2lf\n", c[i].unidad * c[i].precio);
            printf("Estado: %s\n\n", c[i].estado);
        }
    }

    return 0;
}
